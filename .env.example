# Copy to .env and fill in. Never commit .env.

# --- Twilio (required to boot) ---
# From the Twilio Console dashboard. Shared across ALL clients.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# --- Server ---
PORT=3000
# Set to "production" before any real traffic. That turns on Twilio
# signature validation, which needs the real public HTTPS URL.
NODE_ENV=development

# --- Internal API (required before real traffic) ---
# Sent as the x-internal-key header on /internal routes. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_KEY=

# --- Owner alerts (required before real traffic) ---
# Ops phone, E.164, that receives [ALERT] texts when something breaks for any client.
OWNER_ALERT_NUMBER=+15550000000

# Twilio number that SENDS the [ALERT] texts. It must be a NON-campaign sender:
# never a shop number and never the demo campaign number.
# Leave blank to log alerts only. Blank never falls back to a client number.
TWILIO_ALERT_FROM_NUMBER=

# --- Google Sheets call log (optional) ---
# One shared service account for all clients. Each client's own sheet ID goes
# in its client record (sheetId), not here. Share each sheet with this email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# --- Intake OCR (optional) ---
# Only needed for handwritten Chapter 3 scans.
OPENAI_API_KEY=
